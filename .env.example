# Copy to .env for local use. Keep real credentials out of Git and notebooks.
# No values are required for import smoke checks or local Chroma setup.

# Optional OpenAI-compatible generation provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional Chroma Cloud. Local persistent Chroma does not need these values.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Local embedding adapter. Model ID/revision must be verified before recording as final.
HF_TOKEN=
BTP_EMBEDDING_MODEL=intfloat/e5-small-v2
BTP_EMBEDDING_REVISION=
BTP_EMBEDDING_DEVICE=cpu
BTP_EMBEDDING_INPUT_LIMIT=
# Leave prefix variables unset to use the verified defaults for the selected model.
BTP_EMBEDDING_DOCUMENT_PREFIX=
BTP_EMBEDDING_QUERY_PREFIX=

# OpenAI-compatible generation adapter; keep the real key in local environment only.
BTP_GENERATION_API_KEY=
BTP_GENERATION_BASE_URL=https://api.tokenfactory.nebius.com/v1/
BTP_GENERATION_MODEL=
BTP_GENERATION_TIMEOUT_SECONDS=30
BTP_GENERATION_MAX_RETRIES=2
BTP_GENERATION_BACKOFF_SECONDS=1
